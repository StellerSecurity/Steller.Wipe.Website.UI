APP_NAME="Stellar Protect"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=warning
APPINSIGHTS_TRACK_ANONYMOUS_USERS=false

CACHE_DRIVER=file
RATE_LIMITER_STORE=file
SESSION_DRIVER=file
SESSION_CONNECTION=default

REDIS_CLIENT=phpredis
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
SESSION_LIFETIME=15
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null

WIPE_SESSION_MAX_AGE_SECONDS=900
WIPE_CONFIRMATION_MAX_AGE_SECONDS=300
WIPE_API_BASE_URL=https://stellerphonewipeapiprod.azurewebsites.net/api/
WIPE_API_USERNAME=
WIPE_API_PASSWORD=
WIPE_API_TOKEN_LOOKUP_METHOD=get

AZURE_FRONT_DOOR_REQUIRED=false
AZURE_FRONT_DOOR_ID=

# Production must use HTTPS-only cookies, Redis-backed sessions/rate limits,
# and Front Door origin restrictions. See deployment instructions supplied with the patch.
